@page "/"
@inject AppDbContext Db

<div class="container py-4">

    <div class="mb-4 text-center">
        <h2 class="fw-bold">📦 Todo Manager</h2>
        <p class="text-muted">IndexedDB + Blazor CRUD Sample</p>
    </div>

    <!-- ADD CARD -->
    <div class="card mb-3 shadow-sm">
        <div class="card-body d-flex gap-2">

            <input class="form-control"
                   placeholder="Enter new todo..."
                   @bind="title"
                   @bind:event="oninput" />

            <button class="btn btn-primary"
                    @onclick="AddTodo">
                + Add
            </button>

        </div>
    </div>

    <!-- LIST -->
    @if (todos.Count == 0)
    {
        <div class="alert alert-secondary text-center">
            No todos yet
        </div>
    }

    @foreach (var item in todos)
    {
        <div class="card mb-2 shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">

                <!-- LEFT -->
                <div class="d-flex align-items-center gap-2">

                    <input type="checkbox"
                           class="form-check-input"
                           checked="@item.IsDone"
                           @onchange="() => Toggle(item)" />

                    @if (editId == item.Id)
                    {
                        <input class="form-control"
                               style="max-width:250px"
                               @bind="editTitle"
                               @bind:event="oninput" />
                    }
                    else
                    {
                        <span class="@(item.IsDone ? "text-decoration-line-through text-muted" : "")">
                            @item.Title
                        </span>
                    }

                </div>

                <!-- RIGHT -->
                <div class="d-flex gap-2">

                    @if (editId == item.Id)
                    {
                        <button class="btn btn-success btn-sm"
                                @onclick="SaveEdit">
                            Save
                        </button>

                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="CancelEdit">
                            Cancel
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-outline-primary btn-sm"
                                @onclick="() => StartEdit(item)">
                            Edit
                        </button>

                        <button class="btn btn-outline-danger btn-sm"
                                @onclick="() => Delete(item)">
                            Delete
                        </button>
                    }

                </div>

            </div>
        </div>
    }

</div>

@code {
    private string title = "";
    private List<TodoItem> todos = new();

    private Guid? editId;
    private string editTitle = "";

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        todos = (await Db.Todos.GetAllAsync()).ToList();
    }

    // ---------------- CREATE ----------------
    private async Task AddTodo()
    {
        if (string.IsNullOrWhiteSpace(title))
            return;

        await Db.Todos.AddAsync(new TodoItem
        {
            Title = title,
            IsDone = false
        });

        title = "";
        await Load();
    }

    // ---------------- TOGGLE ----------------
    private async Task Toggle(TodoItem item)
    {
        item.IsDone = !item.IsDone;
        await Db.Todos.AddAsync(item);
        await Load();
    }

    // ---------------- EDIT ----------------
    private void StartEdit(TodoItem item)
    {
        editId = item.Id;
        editTitle = item.Title;
    }

    private void CancelEdit()
    {
        editId = null;
        editTitle = "";
    }

    private async Task SaveEdit()
    {
        var item = todos.FirstOrDefault(x => x.Id == editId);
        if (item is null) return;

        item.Title = editTitle;

        await Db.Todos.UpdateAsync(item);

        editId = null;
        editTitle = "";

        await Load();
    }

    // ---------------- DELETE ----------------
    private async Task Delete(TodoItem item)
    {
        await Db.Todos.DeleteAsync(item.Id);
        await Load();
    }
}