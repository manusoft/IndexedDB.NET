<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<RootNamespace>ManuHub.IndexedDB</RootNamespace>
	<AssemblyName>ManuHub.IndexedDB</AssemblyName>	
	<PackageId>ManuHub.IndexedDB</PackageId>
	<Version>1.2.0</Version>
	<Authors>ManuHub</Authors>
	<Company>ManuHub</Company>
	<Description>EF Core–style IndexedDB wrapper for Blazor WebAssembly with clean CRUD, batch operations, and JSInterop abstraction.</Description>
	<Copyright>© 2026 ManuHub. Allrights researved</Copyright>
	<PackageTags>blazor;indexeddb;wasm;database;offline;storage;orm</PackageTags>
	<RepositoryUrl>https://github.com/manusoft/IndexedDB.NET</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<PackageIcon>icon.png</PackageIcon>
	<Icon>icon.png</Icon>
	<IsPackable>true</IsPackable>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
	<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
	<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
	<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.*" />
  </ItemGroup>

 <ItemGroup>
	<Content Include="icon.png" Pack="true" PackagePath="" />
	<Content Include="LICENSE.txt" Pack="true" PackagePath="" />
	<Content Include="README.md" Pack="true" PackagePath="" />
 </ItemGroup>

</Project>
